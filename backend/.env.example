# ============ HoraPro backend — variables de entorno ============
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# --- Obligatorias ---

# MySQL (en Banahosting: cPanel → MySQL Databases; el host suele ser localhost)
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/nombre_bd"

# Secreto de sesiones JWT. En producción es OBLIGATORIO (el servidor no arranca sin él).
# Genera uno con: openssl rand -hex 32
JWT_SECRET=""

# Entorno: en el servidor SIEMPRE "production"
NODE_ENV="production"

# Puerto del API (Banahosting lo asigna en Setup Node.js App)
PORT=3001

# Dominio del frontend, para CORS y para los links de los correos.
# Acepta varios separados por coma.
FRONTEND_ORIGIN="https://horapro.krumlab.com"

# --- Wompi (pagos) ---
# Sandbox: llaves test_* con https://sandbox.wompi.co/v1
# Producción: llaves prod_* con https://production.wompi.co/v1
WOMPI_API_URL="https://production.wompi.co/v1"
WOMPI_PUBLIC_KEY="pub_prod_xxxxxxxx"
WOMPI_PRIVATE_KEY="prv_prod_xxxxxxxx"
WOMPI_INTEGRITY_SECRET="prod_integrity_xxxxxxxx"
WOMPI_EVENTS_SECRET="prod_events_xxxxxxxx"

# --- Correo (recuperación de contraseña) ---
# En Banahosting: cPanel → Email Accounts → crear no-responder@krumlab.com
# Host SMTP: mail.krumlab.com · Puerto 465 (SSL)
SMTP_HOST="mail.krumlab.com"
SMTP_PORT=465
SMTP_USER="no-responder@krumlab.com"
SMTP_PASS=""
SMTP_FROM="\"HoraPro\" <no-responder@krumlab.com>"

# --- Solo para el seed de producción (opcional) ---
# SUPERADMIN_EMAIL="tu@correo.co"
# SUPERADMIN_PASSWORD="una-clave-fuerte"

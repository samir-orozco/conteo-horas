# ============ HoraPro backend — variables de entorno ============
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# --- Obligatorias ---

# MySQL (en Banahosting: cPanel → MySQL Databases; el host suele ser localhost)
#
# connection_limit y pool_timeout son OBLIGATORIOS en Banahosting: sin ellos,
# Prisma calcula el tamaño del pool según las CPU FÍSICAS del servidor (no las
# de tu cuenta) — en un host compartido con 64-88 CPUs eso intenta abrir más de
# 100 conexiones a la vez, contra un usuario de MySQL que suele tener un tope
# de 10-25. Con esto se queda en 5 conexiones como máximo, y si se agotan,
# responde error en 10s en vez de colgarse esperando indefinidamente.
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/nombre_bd?connection_limit=5&pool_timeout=10"

# Secreto de sesiones JWT. En producción es OBLIGATORIO (el servidor no arranca sin él).
# Genera uno con: openssl rand -hex 32
JWT_SECRET=""

# Entorno: en el servidor SIEMPRE "production"
NODE_ENV="production"

# Puerto del API (Banahosting lo asigna en Setup Node.js App)
PORT=3001

# Dominio del frontend, para CORS y para los links de los correos.
# Acepta varios separados por coma.
FRONTEND_ORIGIN="https://horapro.co"

# --- Wompi (pagos) ---
# Sandbox: llaves test_* con https://sandbox.wompi.co/v1
# Producción: llaves prod_* con https://production.wompi.co/v1
WOMPI_API_URL="https://production.wompi.co/v1"
WOMPI_PUBLIC_KEY="pub_prod_xxxxxxxx"
WOMPI_PRIVATE_KEY="prv_prod_xxxxxxxx"
WOMPI_INTEGRITY_SECRET="prod_integrity_xxxxxxxx"
WOMPI_EVENTS_SECRET="prod_events_xxxxxxxx"

# --- Correo (recuperación de contraseña) ---
# En Banahosting: cPanel → Email Accounts → crear no-responder@krumlab.com
# Host SMTP: mail.krumlab.com · Puerto 465 (SSL)
SMTP_HOST="mail.krumlab.com"
SMTP_PORT=465
SMTP_USER="no-responder@krumlab.com"
SMTP_PASS=""
SMTP_FROM="\"HoraPro\" <no-responder@krumlab.com>"

# --- Solo para el seed de producción (opcional) ---
# SUPERADMIN_EMAIL="tu@correo.co"
# SUPERADMIN_PASSWORD="una-clave-fuerte"

# --- Archivo de log (producción) ---
# Sin esta variable, la app imprime a consola, que es lo cómodo en desarrollo.
#
# En Banahosting hace falta ponerla: cPanel descarta lo que la app imprime a
# stdout. Comprobado el 19 de septiembre de 2026 en el servidor: `stderr.log` de
# la app llevaba congelado desde julio y en `~/logs/` solo hay registros de
# acceso de Apache. O sea que durante dos meses no quedó rastro de nada, ni de
# los barridos diarios ni de un solo error. El panel de Node de cPanel no ofrece
# campo de log, así que el destino se configura aquí.
#
# Con la variable puesta se apaga además el registro de CADA petición HTTP: con
# él, el archivo crece unos 75 MB al mes y pide rotación; sin él son unas veinte
# líneas al día. Los errores se siguen registrando, que es lo que importa.
# LOG_FILE="/home/ewyfwxbg/logs/horapro-api.log"

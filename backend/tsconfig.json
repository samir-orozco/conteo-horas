{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // Las pruebas viven junto al código que prueban, pero NO se compilan: `tsc`
  // las metería en dist/ y viajarían al servidor con cada despliegue.
  "exclude": ["src/**/*.test.ts"],
  "ts-node": {
    "files": true
  }
}
